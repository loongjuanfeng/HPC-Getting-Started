# Normalize text files in the repository.
* text=auto eol=lf

# Source and build configuration
*.cc text eol=lf diff=cpp
*.c text eol=lf diff=cpp
*.cpp text eol=lf diff=cpp
*.cxx text eol=lf diff=cpp
*.h text eol=lf diff=cpp
*.hh text eol=lf diff=cpp
*.hpp text eol=lf diff=cpp
*.hxx text eol=lf diff=cpp
CMakeLists.txt text eol=lf
*.cmake text eol=lf
Makefile text eol=lf

# Documentation and structured text
*.md text eol=lf diff=markdown
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.csv text eol=lf

# Scripts
*.sh text eol=lf
*.py text eol=lf

# Binary artifacts and datasets
*.a binary
*.dll binary
*.dylib binary
*.exe binary
*.lib binary
*.o binary
*.obj binary
*.out binary
*.so binary
*.gz binary
*.tar binary
*.tgz binary
*.zip binary
*.7z binary
*.bz2 binary
*.xz binary
*.bin binary
*.dat binary
*.npy binary
*.npz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
