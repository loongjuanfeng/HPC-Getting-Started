{
    "version": 6,
    "configurePresets": [
        {
            "name": "ninja-release",
            "displayName": "Ninja Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_COMPILER": "/usr/bin/gcc-14",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++-14",
                "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-14",
                "CMAKE_CUDA_ARCHITECTURES": "86",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja-release-build",
            "configurePreset": "ninja-release"
        }
    ],
    "workflowPresets": [
        {
            "name": "ninja-release-full",
            "steps": [
                {
                    "type": "configure",
                    "name": "ninja-release"
                },
                {
                    "type": "build",
                    "name": "ninja-release-build"
                }
            ]
        }
    ]
}
