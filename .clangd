CompileFlags:
  CompilationDatabase: build
  Add:
    - -Wall
    - -Wextra
    - -ffast-math
  Remove:
    - -fmodules-ts
    - -fmodule-mapper=*
    - -fdeps-format=*

Diagnostics:
  Suppress:
    - drv_unknown_argument
    - capture_binding_openmp
  ClangTidy:
    Add:
      - modernize-*
      - performance-*
      - readability-*
    Remove:
      - modernize-use-trailing-return-type
      - readability-identifier-length
      - readability-named-parameter
      - readability-function-cognitive-complexity
---
If:
  PathMatch: .*\.cc

CompileFlags:
  Add:
    - -std=c++23
    - -fopenmp
---
If:
  PathMatch: .*\.cu

CompileFlags:
  Compiler: /usr/bin/clang-20
  Add:
    - -x
    - cuda
    - -std=c++20
    - --cuda-gpu-arch=sm_86
    - --cuda-host-only
    - -nocudainc
    - -nocudalib
    - -isystem
    - /usr/local/cuda/include
  Remove:
    - -std=*
    - -x
    - -forward-unknown-to-host-compiler
    - -ccbin=*
    - --generate-code=*
    - -Xcompiler=*
    - --use_fast_math
